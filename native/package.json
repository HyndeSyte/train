{
  "name": "train-native",
  "version": "0.1.0",
  "private": true,
  "description": "Train native shell (Capacitor 8.5, SPM, XcodeGen). The web app lives at the repo root; the copy step patches the shell's own copy under www/.",
  "type": "module",
  "scripts": {
    "copy": "node scripts/copy-www.mjs",
    "sync": "node scripts/copy-www.mjs && cap sync ios",
    "test": "node --test"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
